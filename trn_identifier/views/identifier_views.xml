<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trn_identifier_form" model="ir.ui.view">
        <field name="name">trn.identifier.form</field>
        <field name="model">trn.identifier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="value" placeholder="e.g. 2024-00123"/>
                        </h1>
                    </div>
                    <!-- Section: Identity -->
                    <group col="2">
                        <group name="identity">
                            <field name="type_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group name="technical">
                            <field name="system_uri"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group name="additional_identifier" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trn_identifier_list" model="ir.ui.view">
        <field name="name">trn.identifier.list</field>
        <field name="model">trn.identifier</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="type_id"/>
                <field name="value"/>
                <field name="system_uri" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_trn_identifier_search" model="ir.ui.view">
        <field name="name">trn.identifier.search</field>
        <field name="model">trn.identifier</field>
        <field name="arch" type="xml">
            <search string="Search Identifiers">
                <field name="value"/>
                <field name="partner_id"/>
                <field name="type_id"/>
                <field name="system_uri"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group name="group_by">
                    <filter name="group_type" string="Identifier Type"
                            context="{'group_by': 'type_id'}"/>
                    <filter name="group_partner" string="Partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trn_identifier" model="ir.actions.act_window">
        <field name="name">Identifiers</field>
        <field name="res_model">trn.identifier</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
