# Odoo Project Production Environment Configuration
#
# Copy this file to .env.production and configure for your deployment:
#   cp docker/.env.production.example docker/.env.production
#
# SECURITY: Never commit .env.production to version control!

# =============================================================================
# REQUIRED - You must set these values
# =============================================================================

# Domain name for your Odoo instance
DOMAIN=project.example.org

# Email for Let's Encrypt SSL certificate notifications
ACME_EMAIL=admin@example.org

# Database password (use a strong, random password)
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Odoo admin/master password (for database management)
# Generate with: openssl rand -base64 32
ODOO_ADMIN_PASSWD=CHANGE_ME_ADMIN_PASSWORD_HERE

# =============================================================================
# DATABASE - Local PostgreSQL or External (RDS/Cloud SQL)
# =============================================================================

# Option 1: Local PostgreSQL (default)
# Uses the db service defined in docker-compose.production.yml
DB_HOST=db
DB_PORT=5432
DB_USER=odoo
DB_NAME=odoo

# Option 2: External Database (RDS, Cloud SQL, etc.)
# Uncomment DATABASE_URL and comment out the db service in compose file
# DATABASE_URL=postgres://user:password@hostname:5432/odoo?sslmode=require

# SSL mode for database connection
# Options: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=prefer

# =============================================================================
# PERFORMANCE - Adjust based on your VPS size
# =============================================================================

# Sizing Guide:
#   10k records:  4 vCPU / 8GB  -> WORKERS=2, ODOO_MEMORY=4G, DB_MEMORY=3G
#   50k records:  4 vCPU / 16GB -> WORKERS=4, ODOO_MEMORY=8G, DB_MEMORY=6G
#   100k records: 8 vCPU / 32GB -> WORKERS=6, ODOO_MEMORY=12G, DB_MEMORY=16G

# Number of Odoo workers (rule: 1 worker per 2 CPU cores)
ODOO_WORKERS=2

# Queue job concurrent channels
ODOO_QUEUE_JOB_CHANNELS=root:2

# Memory limits (Docker format: 512M, 1G, 2G, etc.)
ODOO_MEMORY_LIMIT=4G
ODOO_MEMORY_RESERVATION=2G
DB_MEMORY_LIMIT=4G
DB_MEMORY_RESERVATION=2G
QUEUE_MEMORY_LIMIT=2G
QUEUE_MEMORY_RESERVATION=1G

# Per-worker memory limits (in bytes)
# Soft: worker recycled when exceeded
# Hard: worker killed when exceeded
ODOO_MEMORY_SOFT=2147483648
ODOO_MEMORY_HARD=2684354560

# Request timeouts (seconds)
ODOO_TIME_CPU=600
ODOO_TIME_REAL=1200

# =============================================================================
# MODULES - Initial installation
# =============================================================================

# Modules to install on first boot
# Examples:
#   tpl_vocabulary              - Minimal installation
ODOO_INIT_MODULES=tpl_vocabulary

# =============================================================================
# EMAIL (Optional)
# =============================================================================

# SMTP server for outgoing emails
# SMTP_SERVER=smtp.example.org
# SMTP_PORT=587
# SMTP_SSL=True
# SMTP_USER=notifications@example.org
# SMTP_PASSWORD=smtp_password_here
# EMAIL_FROM=Odoo <notifications@example.org>

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warn, error, critical
LOG_LEVEL=warn

# =============================================================================
# BACKUPS
# =============================================================================

# Backup schedule (cron format)
# Default: daily at 2am
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# ANTIVIRUS (Optional - enable with --profile clamav)
# =============================================================================

# Enable ClamAV antivirus scanning when:
#   - Accepting file uploads from users
#   - Processing documents from external sources
#   - Compliance requirements mandate it
#
# To enable: docker compose -f docker/docker-compose.production.yml --profile clamav up -d
# Then install tpl_attachment_av_scan module in Odoo

# Memory limits for ClamAV (needs ~1GB for virus definitions)
CLAMAV_MEMORY_LIMIT=1536M
CLAMAV_MEMORY_RESERVATION=512M

# =============================================================================
# DOCKER IMAGE
# =============================================================================

# Use pre-built image or build locally
# For production, use a specific version tag
# PROJECT_IMAGE=ghcr.io/your-org/odoo-project:v2.0.0
PROJECT_IMAGE=ghcr.io/your-org/odoo-project:latest
