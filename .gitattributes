# Normalize line endings across platforms
* text=auto eol=lf

# Shell scripts must always use LF (CRLF breaks shebangs)
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.geojson filter=lfs diff=lfs merge=lfs -text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
