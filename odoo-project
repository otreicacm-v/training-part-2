def _discover_modules(names: list | None = None) -> list:
    """Return module directories. If names given, validate they exist."""
    if names:
        modules = []
        for name in names:
            mod_dir = PROJECT_ROOT / name
            if not (mod_dir / "__manifest__.py").exists():
                error(f"Module '{name}' not found (no __manifest__.py)")
                sys.exit(1)
            modules.append(mod_dir)
        return modules

    # All modules in project root
    return sorted(p for p in PROJECT_ROOT.iterdir() if p.is_dir() and (p / "__manifest__.py").exists())


def _find_ai_agent() -> str | None:
    """Find available AI agent CLI (cursor-agent or claude)."""
    agent = os.environ.get("AI_AGENT_CMD")
    if agent:
        return agent
    for candidate in ("cursor-agent", "claude"):
        if shutil.which(candidate):
            return candidate
    return None


def _run_ai_agent(prompt: str, cwd: Path | None = None, model: str = "composer-1", force: bool = False) -> str | None:
    """Invoke AI agent and return stdout, or None on failure."""
    agent = _find_ai_agent()
    if not agent:
        warn("No AI agent available (install cursor-agent or claude, or set AI_AGENT_CMD)")
        return None

    cmd = [agent, "-p", "--model", model]
    if force:
        cmd.append("--force")
    cmd.append(prompt)
    result = run(
        cmd,
        capture=True,
        check=False,
        cwd=cwd or PROJECT_ROOT,
    )
    if result.returncode != 0:
        warn(f"AI agent ({agent}) returned non-zero exit code")
    return result.stdout


