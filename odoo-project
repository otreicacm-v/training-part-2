def cmd_test(args):
    """Run tests for a module (isolated from dev instance)."""
    if not args.module:
        print("Usage: ./odoo-project test <module> [--tags=...] [--local|--docker]")
        print("\nExamples:")
        print("  ./odoo-project test trn_vocabulary")
        print("  ./odoo-project test trn_vocabulary --tags=post_install")
        sys.exit(1)

    module = args.module

    # Local mode: delegate to bash script (requires Linux/bash)
    if args.local or (IS_REMOTE and not args.docker):
        info("Local mode requires bash — delegating to scripts/test_single_module.sh")
        script = str(PROJECT_ROOT / "scripts" / "test_single_module.sh")
        cmd = [script, module, "--local"]
        if args.tags:
            cmd.append(f"--test-tags={args.tags}")
        sys.exit(run(cmd, check=False).returncode)

    # Docker mode: pure Python implementation
    _test_docker(module, tags=args.tags)


