def cmd_resetdb(args):
    """Reset database with optional demo data."""
    if IS_REMOTE:
        print("Error: 'resetdb' not supported in Claude Code web environment")
        sys.exit(1)

    db_name = args.db or "odoo"
    modules = "trn_vocabulary"

    # Validate database name to prevent SQL injection
    if not _validate_db_name(db_name):
        print(f"Error: Invalid database name '{db_name}'")
        print("Database names must start with a letter or underscore,")
        print("contain only alphanumeric characters and underscores,")
        print("and be at most 63 characters.")
        sys.exit(1)

    if args.demo:
        demo_key = args.demo.lower().replace("-", "").replace("_", "")
        modules = DEMO_PROFILES.get(demo_key, args.demo)

    # Confirm destructive operation
    if not args.yes and not _confirm(f"This will DROP database '{db_name}'. Continue?"):
        print("Cancelled.")
        sys.exit(0)

    print(f"Resetting database '{db_name}' with modules: {modules}")

    # Ensure db is running
    run(docker_compose("up", "-d", "db"))

    # Stop Odoo but keep db
    run(docker_compose("stop", "odoo-app", "odoo-dev"), check=False)

    # Wait for db to be ready
    print("Waiting for database...")
    for _ in range(30):
        result = run(
            docker_compose("exec", "-T", "db", "pg_isready", "-U", "odoo"),
            check=False,
            capture=True,
        )
        if result.returncode == 0:
            break
        time.sleep(1)

    # Drop and recreate database (db_name is validated above)
    run(
        docker_compose(
            "exec", "-T", "db", "psql", "-U", "odoo", "-d", "postgres", "-c", f"DROP DATABASE IF EXISTS {db_name};"
        ),
        check=False,
    )
    run(docker_compose("exec", "-T", "db", "psql", "-U", "odoo", "-d", "postgres", "-c", f"CREATE DATABASE {db_name};"))

    # Store modules for start command to pick up
    os.environ["ODOO_INIT_MODULES"] = modules
    os.environ["ODOO_DB_NAME"] = db_name

    print(f"Database '{db_name}' reset. Run './odoo-project start' to initialize with {modules}")


