# Text file extensions safe to perform replacements in
_TEXT_EXTENSIONS = {
    ".py",
    ".xml",
    ".csv",
    ".md",
    ".yml",
    ".yaml",
    ".json",
    ".toml",
    ".cfg",
    ".txt",
    ".rst",
    ".sh",
    ".bash",
    ".html",
    ".css",
    ".js",
    ".scss",
    ".less",
}

# Directories to skip entirely during init
_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".ruff_cache", ".mypy_cache", ".venv", "venv"}


def _is_text_file(path: Path) -> bool:
    """Check if a file is a text file we should perform replacements in."""
    if path.suffix in _TEXT_EXTENSIONS:
        return True
    # Extensionless files that look like scripts (e.g., odoo-project itself)
    if path.suffix == "":
        try:
            with open(path, "rb") as f:
                first_bytes = f.read(2)
                return first_bytes == b"#!"
        except OSError:
            return False
    return False


def cmd_init(args):
    """Initialize the template with a project-specific prefix and name."""
    prefix = args.prefix
    project_name = args.project_name
    dry_run = getattr(args, "dry_run", False) or DRY_RUN

    # --- Validate inputs ---
    if not re.match(r"^[a-z][a-z0-9_]*$", prefix):
        error("Prefix must be lowercase, start with a letter, and contain only a-z, 0-9, underscore")
        sys.exit(1)

    if prefix == "tpl":
        error("Prefix 'tpl' is the template default — pick your own (e.g., 'eh', 'myapp')")
        sys.exit(1)

    if not project_name.strip():
        error("Project name must be non-empty")
        sys.exit(1)

    # Check that template hasn't already been initialized
    trn_dirs = sorted(p for p in PROJECT_ROOT.iterdir() if p.is_dir() and p.name.startswith("trn_"))
    if not trn_dirs:
        error("No trn_* directories found — this template appears to be already initialized")
        sys.exit(1)

    # --- Build replacement map (most specific patterns first) ---
    replacements = [
        ("trn_", f"{prefix}_"),  # module names, XML IDs, CSV entries
        ("trn.", f"{prefix}."),  # Python model names (trn.vocabulary)
        ("trn/", f"{prefix}/"),  # Odoo categories (trn/Core)
        ("trn ", f"{prefix} "),  # display names (trn Vocabulary)
        ("Training Sample", project_name),
    ]

    # --- Collect files to process ---
    files_modified = 0
    dirs_renamed = []
    skipped_binary = 0

    # Collect all text files (excluding skip dirs)
    all_files = []
    for path in sorted(PROJECT_ROOT.rglob("*")):
        # Skip directories in the skip list
        if any(part in _SKIP_DIRS for part in path.parts):
            continue
        if path.is_file() and _is_text_file(path):
            all_files.append(path)
        elif path.is_file() and path.suffix not in _TEXT_EXTENSIONS:
            skipped_binary += 1

    # --- Replace in file contents ---
    if dry_run:
        print(_color("1;34", "Dry run — showing what would change:\n"))

    for filepath in all_files:
        try:
            content = filepath.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            skipped_binary += 1
            continue

        new_content = content
        for old, new in replacements:
            new_content = new_content.replace(old, new)

        if new_content != content:
            if dry_run:
                rel = filepath.relative_to(PROJECT_ROOT)
                # Count occurrences
                changes = []
                for old, new in replacements:
                    count = content.count(old)
                    if count:
                        changes.append(f"{old} -> {new} ({count}x)")
                info(f"  {rel}: {', '.join(changes)}")
            else:
                filepath.write_text(new_content, encoding="utf-8")
            files_modified += 1

    # --- Rename trn_* directories ---
    # Sort by depth (deepest first) to avoid renaming parents before children
    trn_dirs_to_rename = sorted(
        (p for p in PROJECT_ROOT.rglob("trn_*") if p.is_dir() and ".git" not in p.parts),
        key=lambda p: len(p.parts),
        reverse=True,
    )

    for dir_path in trn_dirs_to_rename:
        new_name = dir_path.name.replace("trn_", f"{prefix}_", 1)
        new_path = dir_path.parent / new_name
        rel_old = dir_path.relative_to(PROJECT_ROOT)
        rel_new = new_path.relative_to(PROJECT_ROOT)
        if dry_run:
            info(f"  rename: {rel_old} -> {rel_new}")
        else:
            dir_path.rename(new_path)
        dirs_renamed.append((str(rel_old), str(rel_new)))

    # --- Summary ---
    print("")
    if dry_run:
        print(_color("1;34", "Summary (dry run — no changes made):"))
    else:
        success("Template initialized!")

    info(f"  Files modified: {files_modified}")
    info(f"  Directories renamed: {len(dirs_renamed)}")
    if skipped_binary:
        info(f"  Binary/non-text files skipped: {skipped_binary}")

    if not dry_run:
        print("")
        info("Next steps:")
        info("  ./odoo-project doctor     # verify environment")
        info("  ./odoo-project build      # build Docker image")
        info("  ./odoo-project start      # start Odoo")


