def run(cmd: str | list, check: bool = True, capture: bool = False, **kwargs) -> subprocess.CompletedProcess:
    """Run a command with nice defaults."""
    if isinstance(cmd, str):
        kwargs.setdefault("shell", True)
    kwargs.setdefault("cwd", PROJECT_ROOT)
    if capture:
        kwargs["capture_output"] = True
        kwargs["text"] = True

    # Dry-run mode: print command instead of executing
    if DRY_RUN:
        cmd_str = cmd if isinstance(cmd, str) else " ".join(cmd)
        info(f"[dry-run] {cmd_str}")
        # Return a fake successful result
        return subprocess.CompletedProcess(cmd, 0, stdout="", stderr="")

    return subprocess.run(cmd, check=check, **kwargs)


def docker_compose(*args, profile: str = None) -> list:
    """Build docker compose command."""
    cmd = ["docker", "compose"]
    if profile:
        cmd.extend(["--profile", profile])
    cmd.extend(args)
    return cmd


