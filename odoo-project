        # AI-assisted fixes (unless mechanical-only)
        if not args.mechanical_only and not args.dry_run:
            _run_ai_agent(
                f"Fix the remaining security compliance issues in {module}. " f"Audit output: {audit_result.stdout}",
                cwd=mod_dir,
                force=True,
            )

    print("\n========================================")
    print("Done. Run './odoo-project audit-security' to verify.")


def _apply_security_fixes(mod_dir: Path, dry_run: bool = False) -> int:
    """Apply mechanical re.sub() fixes to XML and Python files. Returns fix count."""
    fixes = 0
    security_dir = mod_dir / "security"

    # Patterns: old -> new  (applied to XML files in security/ and views/)
    # Patterns safe to apply unconditionally
    xml_patterns = [
        # Tuple syntax: (4, ref('...')) -> Command.link(ref('...'))
        (r"\(4,\s*ref\((['\"][^'\"]+['\"])\)\)", r"Command.link(ref(\1))"),
        # Tuple syntax: (6, 0, [...]) -> Command.set([...])
        (r"\(6,\s*0,\s*\[([^\]]*)\]\)", r"Command.set([\1])"),
        # Field name: groups_id -> group_ids
        (r'name="groups_id"', 'name="group_ids"'),
    ]

    xml_dirs = [security_dir, mod_dir / "views"]
    for target_dir in xml_dirs:
        if not target_dir.is_dir():
            continue
        for xml_file in target_dir.glob("*.xml"):
            content = xml_file.read_text(encoding="utf-8")
            new_content = content
            for pattern, replacement in xml_patterns:
                new_content = re.sub(pattern, replacement, new_content)

            # users -> user_ids only in files that reference res.groups
            if 'model="res.groups"' in new_content:
                new_content = new_content.replace('name="users"', 'name="user_ids"')

            if new_content != content:
                fixes += 1
                if dry_run:
                    info(f"  [dry-run] Would fix: {xml_file.relative_to(mod_dir.parent)}")
                else:
                    xml_file.write_text(new_content, encoding="utf-8")
                    info(f"  Fixed: {xml_file.relative_to(mod_dir.parent)}")

    return fixes


def cmd_fix_lint(args):
    """Fix linting issues across modules."""
    modules = _discover_modules(args.modules or None)

    for mod_dir in modules:
        module = mod_dir.name
        print(f"[{module}] Collecting files...")

        # Get tracked files using git ls-files
        result = run(["git", "ls-files", str(mod_dir)], capture=True, check=False)
        if not result.stdout.strip():
            info(f"[{module}] No tracked files; skipping")
            continue

        # Filter out migration folders (handle both / and \ separators)
        all_files = [
            f for f in result.stdout.strip().split("\n") if f and "/migration" not in f and "\\migration" not in f
        ]
        py_files = [f for f in all_files if f.endswith(".py")]
        _PRETTIER_EXTS = (".css", ".html", ".js", ".json", ".md", ".scss", ".xml", ".yaml", ".yml")
        prettier_files = [f for f in all_files if any(f.endswith(ext) for ext in _PRETTIER_EXTS)]

        # Ruff check + fix
        if py_files:
            print(f"[{module}] Ruff on {len(py_files)} Python files...")
            run(["ruff", "check", "--fix", "--exit-non-zero-on-fix", *py_files], check=False)
            print(f"[{module}] Ruff format...")
            run(["ruff", "format", *py_files], check=False)

            # Pylint (if available)
            if shutil.which("pylint"):
                for rcfile in [".pylintrc", ".pylintrc-mandatory"]:
                    rc_path = PROJECT_ROOT / rcfile
                    if rc_path.exists():
                        print(f"[{module}] pylint ({rcfile})...")
                        run(["pylint", f"--rcfile={rc_path}", *py_files], check=False)

        # Prettier (if available)
        if prettier_files and shutil.which("prettier"):
            print(f"[{module}] prettier on {len(prettier_files)} files...")
            run(
                ["prettier", "--write", "--list-different", "--ignore-unknown", *prettier_files],
                check=False,
            )

        # AI-assisted retry if --lint-only not set
        if not args.lint_only:
            agent = _find_ai_agent()
            if agent:
                # Re-run ruff to check if issues remain
                if py_files:
                    check = run(
                        ["ruff", "check", "--exit-non-zero-on-fix", *py_files],
                        capture=True,
                        check=False,
                    )
                    if check.returncode != 0:
                        info(f"[{module}] Issues remain — invoking AI agent...")
                        _run_ai_agent(
                            f"Fix the linting issues in {module}. " f"Ruff output:\n{check.stdout}",
                            cwd=mod_dir,
                        )

    print("\nDone!")


def cmd_audit_modules(args):
    """Audit modules for compliance with project principles."""
    modules = _discover_modules(args.modules or None)
    report_dir = PROJECT_ROOT / "reports" / "compliance"
    report_dir.mkdir(parents=True, exist_ok=True)

    agent = _find_ai_agent()
    if not agent:
        error("No AI agent available (install cursor-agent or claude, or set AI_AGENT_CMD)")
        sys.exit(1)

    # Load principle docs for the prompt
    docs_dir = PROJECT_ROOT / "docs" / "principles"
    docs_content = ""
    if docs_dir.is_dir():
        for doc_file in sorted(docs_dir.glob("*.md")):
            docs_content += f"\n===== FILE: docs/principles/{doc_file.name} =====\n\n"
            docs_content += doc_file.read_text(encoding="utf-8")
            docs_content += "\n\n"

    audit_prompt = (
        "Audit this Odoo module for compliance with project principles.\n\n"
        "Check for:\n"
        "1. Naming: module/model/field names follow trn_*/trn.* conventions\n"
        "2. Security: ir.model.access.csv exists and is complete\n"
        "3. No print() statements — should use _logger\n"
        "4. No bare except: clauses\n"
        "5. No cr.commit() in loops — should use queue_job\n"
        "6. No PII in log messages\n"
        "7. Tests exist for core functionality\n"
        "8. Logging uses lazy formatting (not f-strings or %)\n\n"
        'Return ONLY a JSON object: {"module": "...", "status": "pass|fail|partial", '
        '"issues": [...], "auto_fixed": [...], "summary": "..."}\n\n'
    )

    if args.fix:
        audit_prompt += (
            "AUTO-FIX MODE: Fix clear, mechanical issues directly. "
            "Describe fixes in auto_fixed[]. No large refactors.\n\n"
        )
    else:
        audit_prompt += "REPORT-ONLY MODE: Do NOT modify any files.\n\n"

    audit_prompt += docs_content

    print(f"Auditing {len(modules)} module(s) with {agent}...")
    print(f"Reports: {report_dir}/\n")

    for mod_dir in modules:
        module = mod_dir.name
        report_file = report_dir / f"{module}.json"
        print(f"[{module}] Starting audit...")

        agent_cmd = [agent, "-p", "--output-format", "json", "--model", args.model]
        if args.fix:
            agent_cmd.append("--force")
        agent_cmd.append(audit_prompt)

        result = run(agent_cmd, capture=True, check=False, cwd=mod_dir)
        report_file.write_text(result.stdout or "{}")

        # Parse result
        data = {}
        try:
            data = json.loads(result.stdout) if result.stdout.strip() else {}
            status = data.get("status", "unknown")
            issue_count = len(data.get("issues", []))
            summary = data.get("summary", "")
            print(f"[{module}] {status} (issues: {issue_count})")
            if summary:
                print(f"[{module}] Summary: {summary}")
        except json.JSONDecodeError:
            warn(f"[{module}] Could not parse audit result")

        # Auto-commit if requested
        if args.commit and args.fix:
            auto_fixed = data.get("auto_fixed", [])
            if auto_fixed:
                run(["git", "add", str(mod_dir)], check=False)
                run(
                    ["git", "commit", "-m", f"fix({module}): auto-fix compliance issues"],
                    cwd=mod_dir,
                    check=False,
                )

    # Generate summary
    print("\n=== AUDIT SUMMARY ===")
    print(f"Full reports: {report_dir}/")


